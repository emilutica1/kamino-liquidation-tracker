# All optional. Defaults are free, keyless public Solana endpoints.
# HTTP endpoints for fetching transactions (comma-separated; retries rotate through them)
RPC_HTTP=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
# WebSocket endpoint for the program-log subscription
RPC_WS=wss://api.mainnet-beta.solana.com
# Where liquidations.jsonl is written
DATA_DIR=./data
# Pause between transaction fetches (ms); raise it if a public RPC rate-limits you
FETCH_GAP_MS=600
